# Copy to .env (docker compose reads it automatically). Every value has a
# development default in docker-compose.yml; the ones marked CHANGE must be
# set before this stack faces anything real.

# --- secrets (CHANGE) --------------------------------------------------------
JWT_SECRET=dev-only-jwt-secret-change-me-please
ENCRYPTION_SECRET=dev-only-change-me-encryption-secret-32b
POSTGRES_PASSWORD=simple_erp
RABBITMQ_PASSWORD=simple_erp
# Empty = a random password is generated and printed once in the `migrate` logs.
BOOTSTRAP_ADMIN_PASSWORD=

# --- environment ---------------------------------------------------------------
# APP_ENV=production refuses to boot with any development default left in place
# (see production_config_errors in backend/app/core/config.py).
APP_ENV=development
FRONTEND_BASE_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Number of reverse proxies in front of the API (compose's frontend nginx = 1).
# 0 = the API is reached directly.
TRUSTED_PROXY_HOPS=1
WEB_CONCURRENCY=2
DASHBOARD_CACHE_SECONDS=30

# --- mail (defaults deliver to the bundled Mailpit) ---------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true        # port 587;  use SMTP_SECURE=true instead for port 465
# SMTP_FROM=Simple ERP <you@your-domain.com>
# Gmail / Google Workspace: see DEPLOYMENT.md "Sending mail from Gmail"
